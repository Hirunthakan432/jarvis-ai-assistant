# Choose one or more LLM providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# Required for wake word (free key at https://console.picovoice.ai/)
PORCUPINE_ACCESS_KEY=

# Optional: ElevenLabs for better voice
ELEVENLABS_API_KEY=

# Default model (openai, anthropic, gemini, or ollama)
DEFAULT_LLM=openai
DEFAULT_MODEL=

# Assistant name
ASSISTANT_NAME=Jarvis

# Blank DEFAULT_MODEL chooses a provider-specific default; set it to override.
# Local AI: set DEFAULT_LLM=ollama and download the model in your Ollama server.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Local conversation memory (default: ~/.jarvis/memory.sqlite3)
# JARVIS_MEMORY_PATH=/path/to/memory.sqlite3
MAX_HISTORY_TURNS=20
MAX_MESSAGE_CHARS=12000
