# Choose one or more LLM providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# Required for wake word (free key at https://console.picovoice.ai/)
PORCUPINE_ACCESS_KEY=

# Optional: ElevenLabs for better voice
ELEVENLABS_API_KEY=

# Default model (openai, anthropic, gemini, or ollama)
DEFAULT_LLM=ollama
DEFAULT_MODEL=
# General AI questions are optional. Controls are always matched locally first.
# Set false to start with AI chat/vision disabled (or type /ai off per session).
JARVIS_AI_ENABLED=true

# Assistant name
ASSISTANT_NAME=Jarvis

# Blank DEFAULT_MODEL chooses a provider-specific default; set it to override.
# Local AI: set DEFAULT_LLM=ollama and download the model in your Ollama server.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=60
# New installations start with local commands + optional local AI.
# Existing .env files without these settings preserve their selected provider.
JARVIS_ROUTING_MODE=LOCAL_AI
JARVIS_LOCAL_AI_ENABLED=true
JARVIS_DETERMINISTIC_ENABLED=true
JARVIS_LEARNED_ENABLED=true
JARVIS_SEMANTIC_ENABLED=true
# Paid fallback is opt-in. Use HYBRID plus true to allow it after Ollama fails.
JARVIS_ALLOW_CLOUD_FALLBACK=false
JARVIS_CLOUD_PROVIDER=openai
JARVIS_CLOUD_MODEL=
# Cloud only after local commands: CLOUD_ALLOWED + LOCAL_AI_ENABLED=false,
# with DEFAULT_LLM set to the chosen cloud provider.
JARVIS_EMBEDDING_BACKEND=builtin
# Optional source-install neural model, already downloaded to a local directory:
# JARVIS_EMBEDDING_BACKEND=sentence_transformers
# JARVIS_EMBEDDING_MODEL_PATH=/absolute/path/to/local/model
JARVIS_AUDIT_RETENTION_DAYS=30
JARVIS_AUDIT_MAX_ROWS=10000
JARVIS_VOICE_DUPLICATE_SECONDS=8

# Local conversation memory (default: ~/.jarvis/memory.sqlite3)
# JARVIS_MEMORY_PATH=/path/to/memory.sqlite3
MAX_HISTORY_TURNS=20
MAX_MESSAGE_CHARS=12000

# Advanced integrations (JSON). Only configure commands/devices you trust.
# Windows example: {"vscode":["C:\\Users\\YOU\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe"]}
JARVIS_APPS_JSON={}
# Linux example: {"vscode":["/usr/bin/code"],"arduino":["/home/YOU/arduino-ide.AppImage"]}
# Device values must be exact HTTP(S) JSON endpoints on literal LAN IPs.
JARVIS_DEVICES_JSON={}
# Example: {"distance_meter":"http://192.168.43.155/readings"}
JARVIS_FILE_ROOTS_JSON=[]
# Example: ["/home/YOU/Documents","/home/YOU/Projects"]
# These roots also bound confirmed file creation/copy/move/Trash in device control.
# Device control starts OFF; enable each session with /control on or the GUI.
# See docs/device-control.md for commands and platform requirements.
VOICE_LANGUAGE=en-US
# Local microphone recognition; install/extract a matching Vosk model once.
VOICE_BACKEND=vosk
# Default model folder: ~/.jarvis/models/vosk-en
# VOSK_MODEL_PATH=/absolute/path/to/extracted/vosk-model-small-en-us-0.15
VOSK_MODEL_LANGUAGE=en
# Use google explicitly for cloud recognition; it is blocked while AI is off.
# A local model never falls back to Google. Changing VOICE_LANGUAGE needs a
# matching VOSK_MODEL_LANGUAGE/model; Tamil offline model is not bundled.
# For Tamil system speech output choose ta-IN and install a Tamil TTS voice.
REPLY_LANGUAGE=auto
# Reply language: auto, Tamil, English
